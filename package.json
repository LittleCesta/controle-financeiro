{
  "name": "racha-conta",
  "private": true,
  "author": {
    "email": "cesarromero34@gmail.com",
    "name": "Cesar Filho",
    "url": "https://github.com/LittleCesta"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/web/server.ts",
    "bot": "tsx watch --env-file=.env.development src/bot/bot.ts",
    "bot:prod": "tsx --env-file=.env.production src/bot/bot.ts",
    "claim": "tsx --env-file=.env.development src/scripts/claim-groups.ts",
    "claim:prod": "tsx --env-file=.env.production src/scripts/claim-groups.ts",
    "build": "tsc",
    "start": "npm run build && node --env-file=.env.production dist/web/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "grammy": "^1.46.0",
    "mongodb": "^6.8.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "prettier": "^3.10.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
