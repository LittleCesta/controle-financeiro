<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Divisão de gastos</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<main>
  <h1>Divisão de gastos</h1>
  <form method="post" action="/groups" class="row">
    <input name="name" placeholder="Nome do grupo, ex.: Amigos do futebol" required>
    <button>Criar grupo</button>
  </form>
  <% if (!groups.length) { %><p class="muted">Nenhum grupo ainda. Crie o primeiro acima.</p><% } %>
  <ul>
    <% groups.forEach(g => { %><li><a href="/g/<%= g._id %>"><%= g.name %></a></li><% }) %>
  </ul>
</main>
</body>
</html>
